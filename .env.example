# Default: offline simulation, embedded persistent Qdrant, no model downloads.
DIRA_MODE=simulation
DIRA_DATA_DIR=.data
DIRA_API_TOKEN=
DIRA_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
DIRA_QDRANT_URL=
DIRA_DEVICE=auto
DIRA_SIMULATION_INTERVAL=2.5
DIRA_HOT_CAPACITY=4000
DIRA_HOT_SECONDS=7200
DIRA_OUTBOX_LIMIT=50000
# Set an existing local SentenceTransformers model directory for semantic search.
DIRA_EMBEDDING_MODEL=
DIRA_EMBEDDING_DIMENSION=256
DIRA_ROUTER=anchors
# OpenAI-compatible local endpoint INCLUDING /v1 (Ollama, llama.cpp, MLX, vLLM).
DIRA_LLM_URL=
DIRA_LLM_MODEL=local
DIRA_LLM_PROVIDER=local
# Optional cloud trial: URL=https://openrouter.ai/api/v1, PROVIDER=cloud,
# MODEL=qwen/qwen3.6-35b-a3b. Evidence text leaves this machine in cloud mode.
DIRA_LLM_API_KEY=
DIRA_ASR_URL=ws://127.0.0.1:8001/asr
# Transcription backlog ceiling in seconds. Above it, that channel's speech session drops its backlog and
# rejoins live audio (video/OCR continue); the reset and skipped seconds are shown per channel. 0 disables.
DIRA_ASR_MAX_LAG=90
DIRA_FEED_CONFIG=infra/feeds.json
DIRA_ENABLE_OCR=false
DIRA_VIDEO_HWACCEL=auto
DIRA_FFMPEG_THREADS=1
DIRA_OCR_CPU_THREADS=1
DIRA_OCR_DETECTION_MODEL=PP-OCRv6_small_det
# Arabic is supported by the v5 recognizer; v6 recognition currently has no Arabic mapping.
DIRA_OCR_RECOGNITION_MODEL=arabic_PP-OCRv5_mobile_rec
# Directory containing det/ and rec/ local PaddleOCR models.
DIRA_OCR_MODEL_DIR=
DIRA_VISUAL_MODEL=
DIRA_BRIEF_HOUR=6
DIRA_NARRATIVE_INTERVAL=300

# Optional secondary extraction. Supply a private random shared token before starting it.
DIRA_EXTRACTOR_TOKEN=
DIRA_EXTRACTOR_CONFIG=infra/extractors.json
DIRA_EXTRACTOR_PUBLISH_BASE=rtsp://127.0.0.1:8554
DIRA_EXTRACTOR_URL=http://127.0.0.1:8002
# Operator-managed regional proxy endpoints. Empty required routes fail closed.
# Examples: http://proxy-host:3128 or socks5h://proxy-host:1080
DIRA_PROXY_KW=
DIRA_PROXY_UK=
# A VPN must be provisioned externally; point a proxy above at its gateway.

# Native Qwen3-ASR launcher. Causal tower currently supports English only.
DIRA_ASR_MODEL_DIR=
DIRA_ASR_LANGUAGE=ar
DIRA_ASR_AUDIO_BACKEND=windowed
DIRA_ASR_DEVICE=mps
DIRA_ASR_HOST=127.0.0.1
DIRA_ASR_PORT=8001
DIRA_ASR_TOWER_CHECKPOINT=

# Operational safeguards (live API ingestion is disabled unless enabled AND authenticated).
DIRA_ALLOWED_HOSTS=127.0.0.1,localhost,::1
DIRA_ALLOW_EXTERNAL_INGEST=false
DIRA_MIN_DISK_FREE_GB=2
DIRA_MEDIA_TIMEOUT=20
# Explicit opt-in for scheduled cloud egress; manual briefs still use the configured provider.
DIRA_CLOUD_AUTO_BRIEFS=false
