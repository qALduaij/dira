# CPU fallback only. Run scripts/start_asr.py natively on macOS for MPS/Metal.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'whisperlivekit[qwen3-streaming]==0.2.26' 'qwen3-asr-causal==0.1.0'
COPY scripts/start_asr.py /app/scripts/start_asr.py
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    DIRA_ASR_DEVICE=cpu DIRA_ASR_HOST=0.0.0.0
EXPOSE 8001
CMD ["python", "/app/scripts/start_asr.py"]
